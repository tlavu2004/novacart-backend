# Spring
SPRING_PROFILES_ACTIVE=local

# Set this to the local application port (typically 8080).
SERVER_PORT=

# Application Database
# Fill these values to match the postgres service in docker-compose.local.yml (typically localhost:5432) before running `make local-up` or `make local-run`.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JPA / Hibernate
# Flyway owns the schema; use validate during normal local development.
SPRING_JPA_HIBERNATE_DDL_AUTO=
SPRING_JPA_SHOW_SQL=
SPRING_JPA_HIBERNATE_FORMAT_SQL=
