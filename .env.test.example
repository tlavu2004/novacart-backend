# Activate the isolated Spring test profile.
SPRING_PROFILES_ACTIVE=
TEST_SERVER_PORT=

# These values must match the postgres service in docker-compose.test.yml.
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# Flyway owns the schema in the test database; validate it at startup.
TEST_SPRING_JPA_HIBERNATE_DDL_AUTO=
TEST_SPRING_JPA_SHOW_SQL=
TEST_SPRING_JPA_HIBERNATE_FORMAT_SQL=
