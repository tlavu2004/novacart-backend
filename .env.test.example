# Spring
# Set this to the test application port (typically 8081).
SERVER_PORT=

# Application Database
# Fill these values to match the postgres service in docker-compose.test.yml
# (typically localhost:5433) before running `make test-up` or `make test-run`.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Flyway owns the schema in the test database; validate it at startup.
SPRING_JPA_HIBERNATE_DDL_AUTO=
SPRING_JPA_SHOW_SQL=
SPRING_JPA_HIBERNATE_FORMAT_SQL=
